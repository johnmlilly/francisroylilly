{
  "name": "francisroylilly",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:seed": "wrangler d1 execute francisroylilly --local --file=db/seed.sql",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "astro check && vitest run && astro build",
    "audit": "npm audit --omit=dev --audit-level=high",
    "analyze": "fallow",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.12",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "react-vertical-timeline-component": "^3.5.3",
    "resend": "^6.28.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@libsql/client": "^0.17.4",
    "drizzle-kit": "^0.31.10",
    "fallow": "^3.27.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
