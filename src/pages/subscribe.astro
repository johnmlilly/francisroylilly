---
import Hero from "../components/Hero.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import { SITE_TITLE } from "../consts.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = `Subscribe | ${SITE_TITLE}`;
---

<BaseLayout title={title} subscribeDialog={false}>
  <Hero title="Subscribe for Updates" />

  <section>
    <div class="container">
      <p>
        Stay up to date on Francis's journey and progress. We will never share
        your email address with anyone else and never send you any spam.
      </p>
      <SubscribeForm heading="Stay Updated" />
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .container > p {
    margin-bottom: 1.5rem;
  }
</style>
