---
import Hero from "../../components/Hero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../../consts.js";
import {
  confirmSubscription,
  lookupConfirmToken,
} from "../../lib/subscriptions.js";

// Reads and writes D1 per request; never prerender.
export const prerender = false;

type View = "missing" | "not-found" | "used" | "pending";

let view: View;
let firstName = "";
let token = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const submitted = form.get("token");

  if (typeof submitted !== "string" || submitted.length === 0) {
    view = "missing";
  } else {
    const result = await confirmSubscription(submitted, new Date());
    if (result === "confirmed") {
      return Astro.redirect("/subscribed", 303);
    }
    view = result === "not-found" ? "not-found" : "used";
  }
} else {
  token = Astro.url.searchParams.get("token") ?? "";

  if (!token) {
    view = "missing";
  } else {
    const lookup = await lookupConfirmToken(token);
    if (lookup.status === "pending") {
      view = "pending";
      firstName = lookup.firstName;
    } else {
      view = lookup.status === "not-found" ? "not-found" : "used";
    }
  }
}

Astro.response.status =
  view === "missing" ? 400 : view === "pending" ? 200 : 404;
const title = `Confirm subscription | ${SITE_TITLE}`;

const heroTitle =
  view === "pending"
    ? `Almost There!`
    : view === "used"
      ? "Already Confirmed"
      : "We Couldn't Find That Link";
---

<BaseLayout
  title={title}
  noindex
  subscribeDialog={false}>
  <Hero title={heroTitle} />

  <section>
    <div class="container">
      {
        view === "pending" && (
          <>
            <p id="confirm-status">One moment, confirming your subscription.</p>
            <form method="POST" action="/api/confirm" id="confirm-form">
              <input type="hidden" name="token" value={token} />
              <noscript>
                <p> Click below to confirm your subscription to start receiving updates.</p>
                <button type="submit" class="confirm__button">Confirm subscription</button>
              </noscript>
            </form>
          </>
        )
      }
      {
        view === "used" && (
          <>
            <p>
              This link has already been used. You're subscribed and don't need
              to do anything else.
            </p>
            <p>
              <a href="/blog">Read the latest updates</a>
            </p>
          </>
        )
      }
      {
        (view === "not-found" || view === "missing") && (
          <>
            <p>
              The confirmation link is missing or no longer valid. You can
              <a href="/subscribe">subscribe again</a> any time.
            </p>
            <p>
              <a href="/">Back to the homepage</a>
            </p>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .confirm__button {
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--primary-color);
    color: white;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .confirm__button:hover {
    background: var(--primary-color-hover);
  }
</style>

<script>
  // Email link stays a plain GET (scanners prefetch links, so a mutating GET
  // would confirm before the recipient opens the message). This script is
  // what turns that GET into the one click the reader actually feels: a
  // scanner fetching the HTML never runs it, but a real browser submits the
  // form immediately, so there's no second click on the page.
  document.getElementById("confirm-form")?.submit();
</script>
