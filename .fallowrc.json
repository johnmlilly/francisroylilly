{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  "ignoreDependencies": [
    // Astro's `imageService: 'compile'` optimizes every image at build time
    // with sharp (see astro.config.mjs). Nothing imports it, but the build
    // fails without it, and astro does not depend on it itself.
    "sharp"
  ],
  "ignoreExports": [
    {
      // Both clients re-export drizzle's `eq` for their own callers. The
      // Turso client (db/client.ts) and the D1 client are never imported
      // together, so the shared name cannot resolve ambiguously here.
      "file": "db/*client.ts",
      "exports": ["eq"]
    }
  ],
  "duplicates": {
    "ignoredClones": [
      // confirm.astro and unsubscribe.astro read a token the same way and then
      // do different things with it. Reviewed: the shapes match, the meaning
      // does not, and a shared helper would only hide that.
      "dup:6f87acd9:2"
    ],
    "ignore": [
      // Generated by `wrangler types` (npm run cf-typegen); repeated AI model
      // schemas here are Cloudflare's codegen output, not copy-paste to fix.
      "worker-configuration.d.ts"
    ]
  },
  "rules": {
    // @astrojs/cloudflare, mdx, react, sitemap and @tailwindcss/vite are
    // imported only by astro.config.mjs, which fallow does not count as
    // production code, so they read as test-only. They are needed for
    // `npm run build`. (@astrojs/rss is different: src/pages/rss.xml.js
    // imports it from production code, so it was never flagged.)
    "test-only-dependencies": "off"
  },
  "overrides": [
    {
      // `alt` is used, at HeroFlip.astro:53, inside an Astro template
      // expression the React prop detector does not follow.
      "files": ["src/components/HeroFlip.astro"],
      "rules": { "unused-component-props": "off" }
    }
  ]
}
